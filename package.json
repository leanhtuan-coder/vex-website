{
  "name": "vex-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "prepare:content": "node scripts/prepare-content.mjs",
    "pretypecheck": "npm run prepare:content",
    "predev": "npm run prepare:content && node scripts/prepare-public.mjs",
    "prebuild": "npm run prepare:content && node scripts/prepare-public.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "measure:performance": "node scripts/measure-performance.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts vite.config.js eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run verify:content && npm run build"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.14.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4"
  }
}
